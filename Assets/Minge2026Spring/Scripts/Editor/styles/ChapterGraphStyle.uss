GridBackground {
    --grid-background-color: #202020;
    --line-color: rgba(255, 255, 255, 0.05);
    --thick-line-color: rgba(255, 255, 255, 0.1);
    --spacing: 15;
}

Toolbar {
    background-color: #383838;
    border-bottom-color: #202020;
    border-bottom-width: 1px;
    height: 30px;
    padding-left: 5px;
}

Button {
    background-color: #4c4c4c;
    border-radius: 3px;
    padding: 3px 10px;
    margin-right: 5px;
    color: #e0e0e0;
}

Button:hover {
    background-color: #606060;
}

Button:active {
    background-color: #2d2d2d;
}

Label#toolbar-title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-right: 20px;
    color: #ffffff;
    align-self: center;
}

#inspector-pane {
    padding: 15px;
    background-color: #2b2b2b;
}

#inspector-title {
    -unity-font-style: bold;
    font-size: 16px;
    margin-bottom: 10px;
    color: #ffffff;
    border-bottom-color: #404040;
    border-bottom-width: 1px;
    padding-bottom: 5px;
}