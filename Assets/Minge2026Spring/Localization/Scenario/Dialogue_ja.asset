    m_Localized: "\u4ECA\u56DE\u306F\u30A2\u30AF\u30B7\u30E7\u30F3\u30B2\u30FC\u30E0\u306B\u3057\u3088\u3046\u3068\u601D\u3046\u3093\u3060\u3051\u3069\u3001\u307F\u3093\u306A\u3069\u3046\u304B\u306A"
