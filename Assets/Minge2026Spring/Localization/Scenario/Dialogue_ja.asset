    m_Localized: "\u3046\u30FC\u3093\u3001\u4FFA\u306F\u4F9D\u983C\u3055\u308C\u305F\u3089\u305D\u308C\u306B\u5408\u308F\u305B\u308B\u4E3B\u7FA9\u306A\u3093\u3067\u3047\u2026\u2026"
